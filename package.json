{
  "name": "auspex",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "./start.sh",
    "dev": "./start.sh",
    "build": "npm run build --workspace=shared && npm run build --workspace=backend && npm run build --workspace=frontend",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "find . -name 'dist' -not -path '*/node_modules/*' -exec rm -rf {} + && find . -name 'node_modules' -maxdepth 2 -exec rm -rf {} +"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
